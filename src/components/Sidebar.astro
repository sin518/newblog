---
/**
 * Chirpy-style fixed left sidebar: avatar (admin login/dashboard entry) +
 * editable profile + nav + personal tools (e.g. Job Radar) + theme toggle + socials.
 */

import { SITE, type Locale } from '../config';
import { localizedPath, withBase } from '../i18n/utils';
import { getSidebarConfig } from '../lib/sidebar-config';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import ThemeToggle from './islands/ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEnglish = locale === 'en';
const isAdmin = Astro.locals.isAdmin;
const home = localizedPath('/', locale);
const avatar = SITE.author.avatar;
const isStringAvatar = typeof avatar === 'string';
const avatarSrc = isStringAvatar ? avatar.trim() : '';

const sidebarConfig = await getSidebarConfig({ includeHidden: isAdmin });

const navItems = sidebarConfig.navItems.map((item) => {
  const isExternal = /^https?:\/\//i.test(item.href);
  return {
    ...item,
    isExternal,
    href: isExternal ? item.href : localizedPath(item.href, locale),
    displayLabel: isEnglish && item.labelEn ? item.labelEn : item.label,
  };
});
---

<aside id="sidebar" class="chirpy-sidebar overflow-y-auto" aria-label="Sidebar">
  {/* Profile */}
  <header class="flex w-full flex-col items-center pt-4 pb-5 text-center">
    <a
      href={withBase(isAdmin ? '/admin' : '/login')}
      class="chirpy-avatar border-base-100 grid h-28 w-28 shrink-0 place-items-center overflow-hidden rounded-full border-4 shadow-sm transition hover:scale-[1.02]"
      style="background:linear-gradient(135deg, var(--color-primary), color-mix(in oklab, var(--color-primary) 70%, white));"
      aria-label={isAdmin ? '进入管理后台' : '站长登录'}
      title={isAdmin ? '进入管理后台' : '站长登录'}
    >
      {
        avatar ? (
          isStringAvatar ? (
            <img
              src={avatarSrc.startsWith('/') ? withBase(avatarSrc) : avatarSrc}
              alt={SITE.author.name}
              width="112"
              height="112"
              class="block h-full w-full object-cover object-center"
              loading="eager"
              decoding="async"
            />
          ) : (
            <Image
              src={avatar}
              alt={SITE.author.name}
              width={112}
              height={112}
              class="block h-full w-full object-cover object-center"
              loading="eager"
              decoding="async"
            />
          )
        ) : (
          <span class="text-primary-content flex h-full w-full items-center justify-center text-3xl font-bold">
            {sidebarConfig.profile.title.charAt(0)}
          </span>
        )
      }
    </a>
    <a
      href={home}
      class="text-base-content hover:text-primary mt-4 text-xl font-semibold tracking-wide"
      aria-label={sidebarConfig.profile.title}
    >
      {sidebarConfig.profile.title}
    </a>
    {
      sidebarConfig.profile.bio && (
        <p class="text-base-content/70 mt-1 max-w-56 text-sm italic">
          {sidebarConfig.profile.bio}
        </p>
      )
    }
  </header>

  {/* Vertical nav */}
  <nav class="chirpy-nav flex-1" aria-label="Main">
    <ul class="contents flex-col gap-0.5">
      {
        navItems.map((item) => {
          const stripped = item.href.replace(/\/+$/, '') || '/';
          const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
          const isActive =
            !item.isExternal &&
            (stripped === current ||
              (stripped !== home.replace(/\/+$/, '') && current.startsWith(stripped + '/')));
          return (
            <li>
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                target={item.isExternal ? '_blank' : undefined}
                rel={item.isExternal ? 'noopener' : undefined}
                class="chirpy-nav-link"
              >
                <Icon name={item.icon || 'lucide:link'} width={16} height={16} />
                <span class="flex-1 truncate">{item.displayLabel}</span>
                {item.hidden && (
                  <span class="badge badge-warning badge-xs">隐藏</span>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  {/* Personal tools in left sidebar */}
  {
    sidebarConfig.tools.length > 0 && (
      <div class="mt-4 w-full space-y-2.5 px-1">
        {sidebarConfig.tools.map((tool) => {
          const eyebrow = isEnglish && tool.eyebrowEn ? tool.eyebrowEn : tool.eyebrow;
          const title = isEnglish && tool.titleEn ? tool.titleEn : tool.title;
          const desc = isEnglish && tool.descriptionEn ? tool.descriptionEn : tool.description;
          const linkText = isEnglish && tool.linkTextEn ? tool.linkTextEn : tool.linkText;
          const isExternal = /^https?:\/\//i.test(tool.href);

          return (
            <div class="border-primary/25 bg-primary/5 rounded-xl border p-3 text-left">
              <div class="flex items-center justify-between gap-1.5">
                {eyebrow && (
                  <p class="text-primary text-[10px] font-bold tracking-wider uppercase">
                    {eyebrow}
                  </p>
                )}
                {tool.hidden && (
                  <span class="badge badge-warning badge-xs">隐藏</span>
                )}
              </div>
              <p class="text-base-content mt-0.5 text-sm font-bold">{title}</p>
              {desc && (
                <p class="text-base-content/70 mt-1 line-clamp-2 text-xs leading-snug">{desc}</p>
              )}
              <a
                href={tool.href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                class="btn btn-primary btn-xs mt-2.5 w-full justify-between"
              >
                <span>{linkText}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          );
        })}
      </div>
    )
  }

  {/* Bottom row: theme toggle + socials */}
  <div
    class="border-base-300 mt-4 flex w-full flex-wrap items-center justify-center gap-2 border-t pt-4"
  >
    <ThemeToggle locale={locale} />
    {
      sidebarConfig.socials.map((s) => (
        <a
          href={s.href.startsWith('/') ? withBase(s.href) : s.href}
          rel="noopener"
          class="chirpy-social"
          aria-label={s.label}
          title={s.hidden ? `${s.label}（仅自己可见）` : s.label}
          target={s.href.startsWith('http') || s.label === 'RSS' ? '_blank' : undefined}
        >
          <Icon name={s.icon || 'lucide:link'} width={16} height={16} />
        </a>
      ))
    }
  </div>
</aside>

{/* Mobile backdrop */}
<button
  type="button"
  data-sidebar-mask
  class="fixed inset-0 z-30 hidden bg-black/40 lg:hidden"
  aria-label="Close sidebar"
  tabindex="-1"></button>

<script>
  function setupSidebar() {
    const sidebar = document.getElementById('sidebar');
    const mask = document.querySelector<HTMLElement>('[data-sidebar-mask]');
    if (!sidebar || !mask) return;

    function open() {
      sidebar?.classList.add('is-open');
      mask?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      sidebar?.classList.remove('is-open');
      mask?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    document.querySelectorAll<HTMLElement>('[data-sidebar-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (sidebar?.classList.contains('is-open')) close();
        else open();
      });
    });
    mask.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    sidebar.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        if (window.matchMedia('(max-width: 1023px)').matches) close();
      }),
    );
  }
  document.addEventListener('astro:page-load', setupSidebar);
</script>

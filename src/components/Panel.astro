---
/**
 * Right-hand panel shown on XL screens, mirrors Chirpy's "Recently Updated"
 * + "Trending Tags" widgets + dynamic personal tool cards.
 *
 * On post pages we replace this with the article TOC (handled by PostLayout).
 */
import type { Locale } from '../config';
import { useTranslations } from '../i18n/utils';
import { getPosts, getTagsWithCount, postPath, tagPath } from '../utils/posts';
import { getPanelTools } from '../lib/panel-tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const isEnglish = locale === 'en';

const isAdmin = Astro.locals.isAdmin;
const [posts, tags, panelTools] = await Promise.all([
  getPosts(locale, { includeHidden: isAdmin }),
  getTagsWithCount(locale, { includeHidden: isAdmin }),
  getPanelTools({ includeHidden: isAdmin }),
]);

const recent = posts
  .slice()
  .sort((a, b) => {
    const at = (a.data.updatedDate ?? a.data.pubDate)?.valueOf?.() ?? 0;
    const bt = (b.data.updatedDate ?? b.data.pubDate)?.valueOf?.() ?? 0;
    return bt - at;
  })
  .slice(0, 5);

const trending = tags.slice(0, 8);
---

<div class="chirpy-panel">
  {
    panelTools.length > 0 && (
      <section class="mb-8 space-y-3">
        {panelTools.map((item) => {
          const eyebrow = isEnglish && item.eyebrowEn ? item.eyebrowEn : item.eyebrow;
          const title = isEnglish && item.titleEn ? item.titleEn : item.title;
          const desc = isEnglish && item.descriptionEn ? item.descriptionEn : item.description;
          const linkText = isEnglish && item.linkTextEn ? item.linkTextEn : item.linkText;
          const isExternal = /^https?:\/\//i.test(item.href);

          return (
            <div class="border-primary/25 bg-primary/5 rounded-xl border p-3.5">
              <div class="flex items-center justify-between gap-2">
                {eyebrow && (
                  <p class="text-primary text-[11px] font-bold tracking-wider uppercase">
                    {eyebrow}
                  </p>
                )}
                {item.hidden && (
                  <span class="badge badge-warning badge-xs">仅自己可见</span>
                )}
              </div>
              <h3 class="text-base-content mt-1 text-sm font-bold">{title}</h3>
              {desc && (
                <p class="text-base-content/70 mt-1 text-xs leading-relaxed">{desc}</p>
              )}
              <a
                href={item.href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                class="btn btn-primary btn-xs mt-3 w-full justify-between"
              >
                <span>{linkText}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          );
        })}
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section class="mb-8">
        <h2 class="text-base-content/70 mb-3 text-xs font-bold tracking-[0.1em] uppercase">
          {t('panel.recentlyUpdated')}
        </h2>
        <ul class="chirpy-aside-list">
          {recent.map((post) => (
            <li>
              <a href={postPath(post)} class="chirpy-aside-item truncate">
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    trending.length > 0 && (
      <section>
        <h2 class="text-base-content/70 mb-3 text-xs font-bold tracking-[0.1em] uppercase">
          {t('panel.trendingTags')}
        </h2>
        <div class="flex flex-wrap gap-2">
          {trending.map((tag) => (
            <a href={tagPath(locale, tag.name)} class="post-tag">
              {tag.name}
            </a>
          ))}
        </div>
      </section>
    )
  }
</div>

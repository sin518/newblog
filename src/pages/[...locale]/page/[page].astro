---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import Pagination from '~/components/Pagination.astro';
import { SITE } from '~/config';
import { localizedPath, resolveLocaleParam, useTranslations } from '~/i18n/utils';
import { getPosts } from '~/utils/posts';

const locale = resolveLocaleParam(Astro.params.locale);
if (!locale) return Astro.rewrite('/404');

const pageNum = Number(Astro.params.page);
if (!Number.isInteger(pageNum) || pageNum < 2) {
  return Astro.rewrite('/404');
}

const t = useTranslations(locale);
const allPosts = await getPosts(locale, { includeHidden: Astro.locals.isAdmin });
const pageSize = SITE.postsPerPage;
const last = Math.max(1, Math.ceil(allPosts.length / pageSize));
if (pageNum > last) return Astro.rewrite('/404');

const current = pageNum;
const start = (current - 1) * pageSize;
const pagePosts = allPosts.slice(start, start + pageSize);

const hrefForPage = (n: number) => localizedPath(n === 1 ? '/' : `/page/${n}/`, locale);
---

<BaseLayout
  title={`${t('list.allPosts')} — ${t('pagination.page')} ${current}`}
  pathWithoutLocale={`/page/${current}/`}
>
  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight">{t('list.allPosts')}</h1>
    <p class="text-base-content/70 text-sm">
      {t('pagination.page')}
      {current}
      {t('pagination.of')}
      {last}
    </p>
  </header>
  <PostList posts={pagePosts} locale={locale} />
  <Pagination currentPage={current} lastPage={last} hrefForPage={hrefForPage} locale={locale} />
</BaseLayout>

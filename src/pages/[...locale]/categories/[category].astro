---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { useTranslations, localizedPath, resolveLocaleParam } from '~/i18n/utils';
import { getPosts, getCategoriesWithCount, slugify } from '~/utils/posts';

const locale = resolveLocaleParam(Astro.params.locale);
const { category } = Astro.params;
if (!locale || !category) return Astro.rewrite('/404');

const isAdmin = Astro.locals.isAdmin;
const categories = await getCategoriesWithCount(locale, { includeHidden: isAdmin });
const matched = categories.find((c) => slugify(c.name) === category);
if (!matched) return Astro.rewrite('/404');

const categoryName = matched.name;
const t = useTranslations(locale);
const posts = (await getPosts(locale, { includeHidden: isAdmin })).filter(
  (p) => p.data.categories && p.data.categories.some((c) => slugify(c) === category),
);
---

<BaseLayout
  title={categoryName}
  pathWithoutLocale={`/categories/${category}/`}
  crumbs={[
    { label: t('categories.title'), href: localizedPath('/categories/', locale) },
    { label: categoryName },
  ]}
>
  <header class="mb-6">
    <p class="text-base-content/70 text-sm tracking-wide uppercase">{t('list.categoryPosts')}</p>
    <h1 class="text-3xl font-bold tracking-tight">{categoryName}</h1>
    <p class="text-base-content/70 mt-1 text-sm">
      {posts.length}
      {posts.length === 1 ? t('list.totalPostsOne') : t('list.totalPosts')}
    </p>
  </header>
  <PostList posts={posts} locale={locale} />
</BaseLayout>

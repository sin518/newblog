---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PostList from "~/components/PostList.astro";
import Pagination from "~/components/Pagination.astro";
import JobRadarSpotlight from "~/components/JobRadarSpotlight.astro";
import { SITE } from "~/config";
import { localizedPath, resolveLocaleParam } from "~/i18n/utils";
import { getPosts } from "~/utils/posts";

const locale = resolveLocaleParam(Astro.params.locale);
if (!locale) return Astro.rewrite("/404");

const posts = await getPosts(locale, { includeHidden: Astro.locals.isAdmin });
const pageSize = SITE.postsPerPage;
const lastPage = Math.max(1, Math.ceil(posts.length / pageSize));
const currentPage = 1;
const pagePosts = posts.slice(0, pageSize);

const hrefForPage = (n: number) =>
  localizedPath(n === 1 ? "/" : `/page/${n}/`, locale);
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  pathWithoutLocale="/"
>
  <JobRadarSpotlight locale={locale} />
  <PostList posts={pagePosts} locale={locale} />
  <Pagination
    currentPage={currentPage}
    lastPage={lastPage}
    hrefForPage={hrefForPage}
    locale={locale}
  />
</BaseLayout>

---
import { getEntry, render } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import { SITE } from '~/config';
import { resolveLocaleParam } from '~/i18n/utils';

const locale = resolveLocaleParam(Astro.params.locale);
if (!locale) return Astro.rewrite('/404');
const entry = await getEntry('pages', `${locale}/about`);
if (!entry) return Astro.rewrite('/404');
const { Content } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description ?? SITE.description}
  locale={locale}
  math={entry.data.math}
>
  <Content />
</PageLayout>

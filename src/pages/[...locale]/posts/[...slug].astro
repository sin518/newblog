---
import PostLayout from '~/layouts/PostLayout.astro';
import { resolveLocaleParam } from '~/i18n/utils';
import { renderMarkdown } from '~/lib/markdown';
import {
  getPostBySlug,
  getPosts,
  postSlug,
  sortPostsByDate,
  type Post,
} from '~/utils/posts';

const locale = resolveLocaleParam(Astro.params.locale);
const slug = Astro.params.slug;
if (!locale || !slug) return Astro.rewrite('/404');

const isAdmin = Astro.locals.isAdmin;
const post = await getPostBySlug(locale, slug, { includeHidden: isAdmin });
if (!post) return Astro.rewrite('/404');

let prev: Post | undefined;
let next: Post | undefined;

if (!post.data.unlisted) {
  const posts = await getPosts(locale, { includeHidden: isAdmin });
  const chronological = sortPostsByDate(posts);
  const idx = chronological.findIndex((p) => postSlug(p) === slug);
  if (idx !== -1) {
    prev = chronological[idx + 1];
    next = chronological[idx - 1];
  }
}

const body = post.body ?? '';
const { html, headings } = renderMarkdown(body);
---

<PostLayout
  post={post}
  headings={headings}
  body={body}
  prev={prev}
  next={next}
  locale={locale}
>
  {
    (post.data.hidden || post.data.draft) && (
      <div class="alert alert-warning mb-6 flex items-center justify-between text-sm">
        <span>
          {post.data.draft ? '当前文章为草稿状态，仅管理员可见。' : '当前文章已设为隐藏，仅管理员可见。'}
        </span>
        <a
          href={`/admin?edit=${encodeURIComponent(post.id)}`}
          class="btn btn-xs btn-outline"
        >
          去后台编辑
        </a>
      </div>
    )
  }
  <Fragment set:html={html} />
</PostLayout>

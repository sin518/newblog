---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { useTranslations, localizedPath, resolveLocaleParam } from '~/i18n/utils';
import { getPosts, getTagsWithCount, slugify } from '~/utils/posts';

const locale = resolveLocaleParam(Astro.params.locale);
const { tag } = Astro.params;
if (!locale || !tag) return Astro.rewrite('/404');

const isAdmin = Astro.locals.isAdmin;
const tags = await getTagsWithCount(locale, { includeHidden: isAdmin });
const matched = tags.find((tg) => slugify(tg.name) === tag);
if (!matched) return Astro.rewrite('/404');

const tagName = matched.name;
const t = useTranslations(locale);
const posts = (await getPosts(locale, { includeHidden: isAdmin })).filter((p) =>
  p.data.tags.some((tg) => slugify(tg) === tag),
);
---

<BaseLayout
  title={`#${tagName}`}
  pathWithoutLocale={`/tags/${tag}/`}
  crumbs={[
    { label: t('tags.title'), href: localizedPath('/tags/', locale) },
    { label: `#${tagName}` },
  ]}
>
  <header class="mb-6">
    <p class="text-base-content/70 text-sm tracking-wide uppercase">{t('list.tagPosts')}</p>
    <h1 class="text-3xl font-bold tracking-tight">#{tagName}</h1>
    <p class="text-base-content/70 mt-1 text-sm">
      {posts.length}
      {posts.length === 1 ? t('list.totalPostsOne') : t('list.totalPosts')}
    </p>
  </header>
  <PostList posts={posts} locale={locale} />
</BaseLayout>
